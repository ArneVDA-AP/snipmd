{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SnipMD",
  "version": "0.1.0",
  "identifier": "com.snipmd.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "SnipMD",
        "width": 1200,
        "height": 820,
        "minWidth": 640,
        "minHeight": 420,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": {
          "allow": ["**/*"],
          "requireLiteralLeadingDot": false
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "category": "DeveloperTool",
    "shortDescription": "Frameless Windows 11 Markdown & Snipping Tool Workspace",
    "longDescription": "Ultra-lightweight frameless Windows 11 Markdown note-taking application with instant Win+Shift+S clipboard paste, CodeMirror 6 inline screenshot widgets, and mark-and-sweep scratchpad garbage collection.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Document",
        "description": "SnipMD Markdown Note",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "windows": {
      "certificateThumbprint": null,
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  }
}
